{
  "name": "i80things",
  "version": "1.0.0",
  "private": true,
  "description": "Daily news from the I-80 corridor in Nebraska",
  "scripts": {
    "511": "node scripts/check-511.mjs",
    "daily": "bash scripts/daily-run.sh",
    "daily:install": "bash scripts/install-daily-run.sh",
    "daily:status": "bash scripts/daily-status.sh",
    "daily:uninstall": "bash scripts/install-daily-run.sh uninstall",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "new": "node scripts/new-post.mjs",
    "log": "node scripts/post-log.mjs",
    "sources": "node scripts/check-sources.mjs",
    "social": "node scripts/social.mjs",
    "social:instagram": "node scripts/publish-instagram.mjs",
    "validate": "node scripts/validate-posts.mjs",
    "brand": "node scripts/generate-brand.mjs",
    "stock": "node scripts/stock-photo.mjs",
    "images:audit": "node scripts/audit-images.mjs",
    "cities:coverage": "node scripts/city-coverage.mjs",
    "factcheck": "node scripts/fact-check.mjs",
    "review": "bash scripts/review-story.sh"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "gray-matter": "^4.0.3",
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
